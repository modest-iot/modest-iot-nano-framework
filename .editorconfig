root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ source files
[*.{h,cpp,ino}]
indent_style = space
indent_size = 4

# Markdown files (preserve formatting)
[*.md]
trim_trailing_whitespace = false

# Text files (keywords, properties)
[*.txt]
indent_style = space
indent_size = 4

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files (GitHub Actions)
[*.yml]
indent_style = space
indent_size = 2

# PlantUML diagrams
[*.puml]
indent_style = space
indent_size = 4

# Doxygen files
[Doxyfile]
indent_style = space
indent_size = 4

[*.dox]
indent_style = space
indent_size = 4
