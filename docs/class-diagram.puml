' ─────────────────────────────────────────────
'  INHERITANCE / REALISATION
' ─────────────────────────────────────────────
EventHandler  <|.. Sensor    : implements
EventHandler  <|.. Device    : implements
CommandHandler <|.. Actuator : implements
CommandHandler <|.. Device   : implements

Sensor <|-- Button
Sensor <|-- DhtSensor
Sensor <|-- UltrasonicSensor
Sensor <|-- PulseSensor
Sensor <|-- LoadCellAmplifier
Sensor <|-- SoilMoistureSensor
Sensor <|-- WaterFlowSensor
Sensor <|-- PthSensor
Sensor <|-- WaterLeakSensor
Sensor <|-- DoorWindowSensor
Sensor <|-- OneWireTemperatureSensor
Sensor <|-- EnvironmentalGasSensor
Sensor <|-- PassiveInfraredSensor
Sensor <|-- DigitalLightIntensitySensor
Sensor <|-- GasSensor
Sensor <|-- GeolocationSensor
Sensor <|-- RfidSensor

Actuator <|-- Led
Actuator <|-- RelayActuator
Actuator <|-- RgbLed
RgbLed ..> RgbColor : uses
Actuator <|-- CharacterLcdDisplay
CharacterLcdDisplay *-- Hd44780Driver : composes
Actuator <|-- ServoMotor
Actuator <|-- Buzzer
Actuator <|-- OledDisplay
OledDisplay *-- Ssd1306Driver : composes

ConnectivityDriver <|.. WiFiConnectivityDriver : implements
ConnectivityDriver <|.. BleConnectivityDriver : implements

GatewayClient <|-- HttpGatewayClient
GatewayClient <|-- MqttGatewayClient
GatewayClient <|-- BleGatewayClient

Device <|-- CustomDevice

' ─────────────────────────────────────────────
'  ASSOCIATIONS
' ─────────────────────────────────────────────
Sensor   "0..1" o--> EventHandler   : eventHandler
Actuator "0..1" o--> CommandHandler : commandHandler
Device   "0..8" o--> SamplingScheduler : scheduler
Device   "0..4" o--> Sensor : triggerTable

GatewayClient     --> ConnectivityDriver : uses
GatewayClient     ..> TelemetryPackage   : serializes

MqttGatewayClient *-- PubSubClient : owns
MqttGatewayClient --> Client       : uses socket
MqttGatewayClient --> Device       : enqueueCommand

WiFiConnectivityDriver ..> WiFiClient : allocates
WiFiConnectivityDriver ..> Client     : exposes

BleConnectivityDriver ..> BLEServer : uses
BleConnectivityDriver ..> BLECharacteristic : uses

GasSensor +-- GasSensor_OperatingMode
GasSensor +-- GasSensor_GasType
GasSensor +-- GasCalibrationParameters

GeolocationSensor *-- LocationData   : caches
GeolocationSensor *-- SoftwareSerial : owns

RfidSensor *-- SPIClass : uses

CustomDevice *--> Sensor   : owns
CustomDevice *--> Actuator : owns

@enduml
