@startuml Modest-IoT-Nano-framework

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

package "Core" #FAFAFA {
  class Event <<struct>> {
    +identifier : int
    +Event(eventIdentifier : int)
    +operator==(other : Event) : bool
  }

  class Command <<struct>> {
    +identifier : int
    +Command(commandIdentifier : int)
    +operator==(other : Command) : bool
  }

  interface EventHandler {
    +on(event : Event) : void
  }

  interface CommandHandler {
    +handle(command : Command) : void
  }

  abstract class Sensor {
    #pin : int
    #eventHandler : EventHandler*
    +{static} DATA_READ_EVENT_IDENTIFIER : int = 20
    +{static} MEASURE_DATA_REQUESTED_EVENT_IDENTIFIER : int = 21
    +{static} DATA_READ_EVENT : Event
    +{static} MEASURE_DATA_REQUESTED_EVENT : Event
    +Sensor(signalGpioPin : int, parentHandler : EventHandler* = nullptr)
    +on(event : Event) : void
    +setHandler(parentHandler : EventHandler*) : void
    #processEvent(event : Event&) : void
  }

  abstract class Actuator {
    #pin : int
    #commandHandler : CommandHandler*
    +Actuator(signalGpioPin : int, parentHandler : CommandHandler* = nullptr)
    +handle(command : Command) : void
    +setHandler(parentHandler : CommandHandler*) : void
    #executeCommand(command : Command) : void
  }

  abstract class Device {
    -scheduledSequences : ScheduledTaskSlot[8]
    -registeredSlotCount : uint8_t
    -activeSequencePointer : uint8_t
    -hardwareSamplingTaskHandle : TaskHandle_t
    -networkDispatcherTaskHandle : TaskHandle_t
    -telemetryQueueHandle : QueueHandle_t
    -hardwareTimer : hw_timer_t*
    -pollingIntervalInMilliseconds : unsigned long
    -hardwareTimerIndex : uint8_t
    #Device(samplingIntervalInMilliseconds : unsigned long,
            timerGroupIndex : uint8_t = 0)
    #initializeAsynchronousEngine(maximumQueueLength : uint8_t = 10) : void
    #enqueueTelemetryPayload(telemetryPackagePointerAddress : TelemetryPackage**) : bool
    #appendSensorToScheduler(targetSensorInstance : EventHandler*, requestedEventIdentifier : int) : bool
    #processQueuedTelemetryData(rawQueueItemPayload : TelemetryPackage*) : void
  }

  abstract class TelemetryPackage {
    +serialize(serializationDestination : JsonDocument&) : void
    +serialize() : JsonDocument
  }
}

package "Sensors" #EEF6EE {
  class Button {
    -lastStableTimestamp : unsigned long
    -debounceDelayInMilliseconds : unsigned long
    -previousState : bool
    +{static} BUTTON_PRESSED_EVENT_IDENTIFIER : int = 10
    +{static} BUTTON_PRESSED_EVENT : Event
    +Button(signalGpioPin : int, debounceDelayInMilliseconds : unsigned long = 50,
            parentHandler : EventHandler* = nullptr)
    #processEvent(event : Event&) : void
  }

  class DhtSensor {
    -physicalDhtSensor : DHT
    -cachedTemperatureInCelsius : float
    -cachedRelativeHumidityInPercentage : float
    +DhtSensor(signalGpioPin : int, dhtModelType : uint8_t,
               parentHandler : EventHandler* = nullptr)
    +getTemperatureInCelsius() : float
    +getRelativeHumidityInPercentage() : float
    #processEvent(event : Event&) : void
  }

  class UltrasonicSensor {
    -echoGpioPin : int
    -cachedDistanceInCentimeters : float
    +UltrasonicSensor(triggerGpioPin : int, echoGpioPin : int,
                      parentHandler : EventHandler* = nullptr)
    +getDistanceInCentimeters() : float
    #processEvent(event : Event&) : void
  }

  class PulseSensor {
    -cachedBeatsPerMinute : int
    -sampleSignalValue : int
    -lastBeatTimestamp : unsigned long
    +PulseSensor(analogInputGpioPin : int, parentHandler : EventHandler* = nullptr)
    +getBeatsPerMinute() : int
    +getRawSignalValue() : int
    #processEvent(event : Event&) : void
  }
}

package "Actuators" #EEF0FF {
  class Led {
    -active : bool
    +{static} TURN_ON_COMMAND_IDENTIFIER : int = 100
    +{static} TURN_OFF_COMMAND_IDENTIFIER : int = 101
    +{static} TOGGLE_LED_COMMAND_IDENTIFIER : int = 102
    +{static} TURN_ON_COMMAND : Command
    +{static} TURN_OFF_COMMAND : Command
    +{static} TOGGLE_LED_COMMAND : Command
    +Led(signalGpioPin : int, initialState : bool = false,
         parentHandler : CommandHandler* = nullptr)
    +isActive() : bool
    #executeCommand(command : Command) : void
  }

  class CharacterLcdDisplay {
    -physicalLcdScreen : LiquidCrystal_I2C
    -maximumRowCount : uint8_t
    -maximumColumnCount : uint8_t
    -characterScreenMatrixBuffer : char*
    -backlightEnabled : bool
    +{static} UPDATE_TEXT_COMMAND_IDENTIFIER : int = 200
    +{static} TURN_BACKLIGHT_ON_COMMAND_IDENTIFIER : int = 201
    +{static} TURN_BACKLIGHT_OFF_COMMAND_IDENTIFIER : int = 202
    +{static} UPDATE_TEXT_COMMAND : Command
    +{static} TURN_BACKLIGHT_ON_COMMAND : Command
    +{static} TURN_BACKLIGHT_OFF_COMMAND : Command
    +CharacterLcdDisplay(i2cAddress : uint8_t, columnCount : uint8_t, rowCount : uint8_t,
                         backlightInitialState : bool = true,
                         parentHandler : CommandHandler* = nullptr)
    +setLineBuffer(rowIndex : uint8_t, nullTerminatedString : char*) : void
    +setLineBuffer(multiLineArrayPointer : char*[]) : void
    +isBacklightOn() : bool
    +getMaximumRowCount() : uint8_t
    +getMaximumColumnCount() : uint8_t
    #executeCommand(command : Command) : void
  }

  class ServoMotor {
    -embeddedServoDriver : Servo
    -currentActiveAngleInDegrees : int
    -bufferedTargetAngleInDegrees : int
    +{static} LOCK_TO_MINIMUM_LIMIT_COMMAND_IDENTIFIER : int = 150
    +{static} LOCK_TO_MAXIMUM_LIMIT_COMMAND_IDENTIFIER : int = 151
    +{static} DRIVE_TO_BUFFERED_ANGLE_COMMAND_IDENTIFIER : int = 152
    +{static} LOCK_TO_MINIMUM_LIMIT_COMMAND : Command
    +{static} LOCK_TO_MAXIMUM_LIMIT_COMMAND : Command
    +{static} DRIVE_TO_BUFFERED_ANGLE_COMMAND : Command
    +ServoMotor(signalGpioPin : int,
               initialAngleInDegrees : int = 0,
               parentHandler : CommandHandler* = nullptr)
    +setTargetAngleBufferInDegrees(targetAngleInDegrees : int) : void
    +getCurrentActiveAngleInDegrees() : int
    #executeCommand(command : Command) : void
  }
}

package "Connectivity" #EDF3FF {
  interface ConnectivityDriver {
    +connect() : void
    +isConnected() : bool
    +canTransmit() : bool
  }

  class WiFiConnectivityDriver {
    -networkSsidIdentifier : char*
    -networkPasswordCredential : char*
    -provisioningRequested : bool
    -hardwareSocket : WiFiClient*
    +WiFiConnectivityDriver(ssid : char*, password : char*)
    +connect() : void
    +isConnected() : bool
    +canTransmit() : bool
    +getNetworkSocket() : Client&
  }
}

package "Gateway" #FFF8EE {
  class EdgeGatewayClient {
    -communicationTransportDriver : ConnectivityDriver&
    -serviceEndpointUrl : char*
    +EdgeGatewayClient(transportDriver : ConnectivityDriver&, targetEndpoint : char*)
    +sendTelemetryRecord(abstractTelemetryPayload : TelemetryPackage&) : bool
  }

  class HttpEdgeGatewayClient {
    -communicationTransportDriver : ConnectivityDriver&
    -serviceEndpointUrl : char*
    -contentTypeHeader : char*
    +HttpEdgeGatewayClient(transportDriver : ConnectivityDriver&, targetEndpoint : char*)
    +sendTelemetryRecord(abstractTelemetryPayload : TelemetryPackage&) : bool
  }

  class MqttGatewayClient {
    -communicationTransportDriver : ConnectivityDriver&
    -mqttClient : PubSubClient
    -clientIdentifier : char*
    -publishTopic : char*
    +MqttGatewayClient(transportDriver : ConnectivityDriver&, networkClient : Client&,
                       brokerIpAddress : char*, brokerPort : uint16_t,
                       topic : char*, deviceId : char* = "ModestIotNode")
    +sendTelemetryRecord(abstractTelemetryPayload : TelemetryPackage&) : bool
  }
}

package "User Application (Sketch)" #FFFDF3 {
  class CustomDevice <<example subclass>> {
    +on(event : Event) : void
    +handle(command : Command) : void
    #processQueuedTelemetryData(rawQueueItemPayload : TelemetryPackage*) : void
  }
}

EventHandler <|.. Sensor : implements
EventHandler <|.. Device : implements
CommandHandler <|.. Actuator : implements
CommandHandler <|.. Device : implements

Sensor <|-- Button
Sensor <|-- DhtSensor
Sensor <|-- UltrasonicSensor
Sensor <|-- PulseSensor

Actuator <|-- Led
Actuator <|-- CharacterLcdDisplay
Actuator <|-- ServoMotor

ConnectivityDriver <|.. WiFiConnectivityDriver : implements

Device <|-- CustomDevice

Sensor "0..1" o--> EventHandler : eventHandler
Actuator "0..1" o--> CommandHandler : commandHandler
Device "0..8" o--> EventHandler : scheduledSequences

EdgeGatewayClient --> ConnectivityDriver : uses
HttpEdgeGatewayClient --> ConnectivityDriver : uses
MqttGatewayClient --> ConnectivityDriver : uses

EdgeGatewayClient ..> TelemetryPackage : serializes
HttpEdgeGatewayClient ..> TelemetryPackage : serializes
MqttGatewayClient ..> TelemetryPackage : serializes

MqttGatewayClient --> Client : uses socket
MqttGatewayClient *-- PubSubClient : owns
WiFiConnectivityDriver ..> WiFiClient : allocates
WiFiConnectivityDriver ..> Client : exposes

CustomDevice *--> Sensor : owns
CustomDevice *--> Actuator : owns

@enduml

