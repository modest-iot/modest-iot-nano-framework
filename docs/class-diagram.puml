    +{static} TURN_OFF_COMMAND_IDENTIFIER : int = 251
    +{static} PLAY_TONE_COMMAND_IDENTIFIER : int = 252
    +{static} TURN_ON_COMMAND : Command
    +{static} TURN_OFF_COMMAND : Command
    +{static} PLAY_TONE_COMMAND : Command
    +Buzzer(signalGpioPin : int, parentHandler : CommandHandler* = nullptr)
