}

package "Connectivity" #EDF3FF {
  interface ConnectivityDriver {
    +connect() : void
    +isConnected() : bool
    +canTransmit() : bool
  }

  class WiFiConnectivityDriver {
    -networkSsidIdentifier : const char*
    -networkPasswordCredential : const char*
    -provisioningRequested : bool
    -hardwareSocket : WiFiClient*
    +WiFiConnectivityDriver(ssid : const char*, password : const char*)
    +connect() : void
    +isConnected() : bool
    +canTransmit() : bool
    +getNetworkSocket() : Client&
  }
}

package "Gateway" #FFF8EE {
  abstract class GatewayClient {
    #communicationTransportDriver : ConnectivityDriver&
    #serviceEndpointUrl : const char*
    +GatewayClient(transportDriver : ConnectivityDriver&, targetEndpoint : const char*)
    +{abstract} sendTelemetryRecord(abstractTelemetryPayload : const TelemetryPackage&) : bool
  }

  class HttpGatewayClient {
    -contentTypeHeader : const char*
    +HttpGatewayClient(transportDriver : ConnectivityDriver&, targetEndpoint : const char*)
    +sendTelemetryRecord(abstractTelemetryPayload : const TelemetryPackage&) : bool
  }

  class MqttGatewayClient {
    -mqttClient : PubSubClient
    -clientIdentifier : const char*
    -publishTopic : const char*
    +MqttGatewayClient(transportDriver : ConnectivityDriver&, networkClient : Client&,
                       brokerIpAddress : const char*, brokerPort : uint16_t,
                       topic : const char*, deviceId : const char* = "ModestIotNode")
    +sendTelemetryRecord(abstractTelemetryPayload : const TelemetryPackage&) : bool
  }
}

package "User Application (Sketch)" #FFFDF3 {
  class CustomDevice <<example subclass>> {
    +on(event : Event) : void
    +handle(command : Command) : void
    #processQueuedTelemetryData(rawQueueItemPayload : const TelemetryPackage*) : void
  }
}

EventHandler <|.. Sensor : implements
EventHandler <|.. Device : implements
CommandHandler <|.. Actuator : implements
CommandHandler <|.. Device : implements

Sensor <|-- Button
Sensor <|-- DhtSensor
Sensor <|-- UltrasonicSensor
Sensor <|-- PulseSensor
Sensor <|-- GasSensor
Sensor <|-- GeolocationSensor

Actuator <|-- Led
Actuator <|-- CharacterLcdDisplay
Actuator <|-- ServoMotor
Actuator <|-- Buzzer

ConnectivityDriver <|.. WiFiConnectivityDriver : implements

Device <|-- CustomDevice

Sensor "0..1" o--> EventHandler : eventHandler
Actuator "0..1" o--> CommandHandler : commandHandler
Device "0..8" o--> EventHandler : scheduledSequences

GatewayClient <|-- HttpGatewayClient
GatewayClient <|-- MqttGatewayClient

GatewayClient --> ConnectivityDriver : uses
HttpGatewayClient --> ConnectivityDriver : uses
MqttGatewayClient --> ConnectivityDriver : uses

GatewayClient ..> TelemetryPackage : serializes
HttpGatewayClient ..> TelemetryPackage : serializes
MqttGatewayClient ..> TelemetryPackage : serializes

MqttGatewayClient --> Client : uses socket
MqttGatewayClient *-- PubSubClient : owns
WiFiConnectivityDriver ..> WiFiClient : allocates
WiFiConnectivityDriver ..> Client : exposes
GeolocationSensor *-- LocationData : caches
GeolocationSensor *-- SoftwareSerial : owns

CustomDevice *--> Sensor : owns
CustomDevice *--> Actuator : owns

@enduml

