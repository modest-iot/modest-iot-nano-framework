  ' --- GasSensor nested types ---
  enum GasSensor_OperatingMode <<GasSensor::OperatingMode>> {
    RawMode
    CalibratingMode
    AccurateMode
  }

  enum GasSensor_GasType <<GasSensor::GasType>> {
    None
    LPG
    Methane
    CarbonMonoxide
    Alcohol
    Propane
    Hydrogen
    Smoke
    Ammonia
    Benzene
    Toluene
    Acetone
  }

  class GasCalibrationParameters <<GasSensor::struct>> {
    +slope : float
    +intercept : float
  }

  class GasSensor {
    -cachedRawAnalogValue : int
    -cachedSensorResistanceInKiloOhm : float
    -cachedRsR0Ratio : float
    -r0InKiloOhm : float
    -digitalInputPin : int
    -cachedDigitalGasDetected : bool
    -currentMode : OperatingMode
    -targetGasType : GasType
    +{static} DIGITAL_GAS_DETECTED_EVENT_IDENTIFIER : int = 40
    +{static} DIGITAL_GAS_DETECTED_EVENT : Event
    +GasSensor(analogInputGpioPin : int,
               digitalInputGpioPin : int = -1,
               parentHandler : EventHandler* = nullptr,
               initialMode : OperatingMode = RawMode)
    +startCalibration() : void
    +setR0(cleanAirResistanceInKiloOhm : float) : void
    +setTargetGas(gasType : GasType) : bool
    +setGasCalibrationParameters(gasType : GasType, slope : float, intercept : float) : bool
    +getOperatingMode() const : OperatingMode
    +getTargetGasType() const : GasType
    +getRawAnalogValue() const : int
    +getSensorResistanceInKiloOhm() const : float
    +getRsR0Ratio() const : float
    +getGasConcentrationInPpm() const : float
    +isGasDetected() const : bool
    #processEvent(event : Event&) : void
  }

  class LocationData <<struct>> {
    +latitudeInDegrees : float
    +longitudeInDegrees : float
    +altitudeInMeters : float
    +speedInKnots : float
    +courseInDegrees : float
    +fixQuality : int
